{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-push-guard.sh\"",
            "if": "Bash(git push*)",
            "timeout": 30,
            "statusMessage": "Comparing branch against origin/main..."
          }
        ]
      }
    ]
  }
}
