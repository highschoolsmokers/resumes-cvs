# macOS
.DS_Store
**/.DS_Store

# Secrets
.env
.env.local

# Build / editor cruft
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.vscode/
.idea/

# Claude Code local-only settings (per-machine); shared config is .claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# Playwright MCP session cache (console/page snapshots from a Claude Code session)
.playwright-mcp/

# LinkedIn updater (scripts/linkedin_apply.py):
#   - the persistent Chrome profile holds logged-in SESSION COOKIES — sensitive.
#   - run screenshots/logs capture the live profile.
#   - the JSON is a rebuildable intermediate (scripts/linkedin_export.py --json).
# linkedin-profile.md itself stays tracked, like the resume-*.md deliverables.
.linkedin-chrome-profile/
linkedin-runs/
linkedin-profile.json

# Temporary Office lock files
~$*.docx
~$*.xlsx
~$*.pptx

# LibreOffice scratch dirs created by scripts/docx_to_pdf.py — normally cleaned
# after a run, but a crashed run can leave one behind.
**/.docx_to_pdf_*/

# Real cover-letter samples (private); profile.md is the tracked voice distillation.
voice/
!voice/README.md

# Real application folders (private). Ingested and rendered per application.
applications/*
