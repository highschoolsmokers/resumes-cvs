# macOS
.DS_Store
**/.DS_Store

# Secrets — never commit
config/secrets.env
config/secrets.*.env
.env
.env.local

# Personal facts — sensitive; .example.yaml is the committed template (§8.7)
config/personal-facts.yaml

# Search run raw dumps — noisy HTML/JSON per the spec (§2)
search/runs/*/raw/

# SQLite seen-cache + transient WAL/journal files. The cache rebuilds
# on first search/run.py invocation; committing the binary doesn't buy
# us anything and clutters diffs.
search/seen.db
*.db-journal
*.db-wal
*.db-shm

# Build / editor cruft
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.vscode/
.idea/

# Claude Code local-only settings (permissions list). Shared config lives
# in .claude/settings.json; .local.json is per-machine.
.claude/settings.local.json

# Playwright MCP session cache — console/page snapshots from browsing
# during a Claude Code session. Never belongs in git.
.playwright-mcp/

# LinkedIn updater (scripts/linkedin_apply.py):
#   - persistent Chrome profile holds the logged-in SESSION COOKIES — sensitive,
#     never commit.
#   - run screenshots/logs capture the live profile.
#   - the JSON is a rebuildable intermediate (scripts/linkedin_export.py --json).
# linkedin-profile.md itself stays tracked, like the resume-*.md deliverables.
.linkedin-chrome-profile/
linkedin-runs/
linkedin-profile.json

# Temporary docx lock files
~$*.docx
~$*.xlsx
~$*.pptx

# PDF/DOCX export intermediates
/tmp_build/

# LibreOffice scratch dir created by scripts/docx_to_pdf.py — normally cleaned
# up after a successful run but a failed run can leave it behind. Never belongs
# in git.
**/.docx_to_pdf_scratch/

# Generated dashboards (regenerated by tracker-agent)
dashboard.md

# --- Private working content (kept in working tree, never committed) ---

# Resume bullets — your actual claims (use bullets.example.yaml if/when one exists)
bullets.yaml

# Populated configs (the .example.yaml siblings are the committed templates)
config/criteria.yaml
config/voice.yaml

# Voice corpus — your actual writing samples and application answers
voice-corpus/*
!voice-corpus/README.md

# Real cover-letter / outreach samples (private). voice.md is the tracked
# distillation; the raw letters in voice/ stay local.
voice/
!voice/README.md

# Search and sweep run artifacts — listings, scores, mail snapshots.
# NOTE: this is stricter than spec §2 (which carves out summary.md / scored.jsonl
# as committable). For a public-template repo, real search results are PII —
# ignore the whole tree.
search/runs/
sweep/runs/

# Real application folders — keep _template, ignore everything else
applications/*
!applications/_template/

# Role-family plan cache — seeds for resume-tailor; derived from prior runs
applications/_plans/

# Derived index + analytics — rebuildable from bullets.yaml / voice-corpus / applications/
# (scripts/build_index.py, scripts/bullet_outcomes.py write here)
state/

# Apply queue — pending URLs the user is going after; history; failures
queue.jsonl
queue.history.jsonl
queue.failed.jsonl
.queue.lock

# Generated generalized resume artifacts (filename includes your name)
*-generalized.docx
*-generalized.pdf
*-generalized.unpacked/
.claude/worktrees/
